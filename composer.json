  "type": "craft-plugin",
  "keywords": ["craft", "cms", "craftcms", "craft-plugin", "commerce", "paystack"],
  "license": "MIT",
  "authors": [
    {
      "name": "Mwanzia Mutua",
      "homepage": "https://dimetechgroup.com"
    }
  ],
  "require": {
    "craftcms/cms": "^4.0.0 || ^5.0.0",
    "craftcms/commerce": "^4.0.0 || ^5.0.0"
